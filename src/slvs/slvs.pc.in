prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@PKGCONFIG_LIBDIR@
includedir=@PKGCONFIG_INCLUDEDIR@

Name: slvshc
Description: SolveSpace geometric constraint solver library, HobbyCAD fork
URL: https://github.com/ayourk/solvespace
Version: @SOLVESPACE_HC_VERSION@
Libs: -L${libdir} -lslvshc
Cflags: -I${includedir}/slvshc
